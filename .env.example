# =============================================================================
# Hyperlocal Marketplace - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows PowerShell)
# 2. Update with secure credentials, especially in staging and production!
# 3. DO NOT commit '.env' to version control.
# =============================================================================

# --- Database Credentials ---
DB_USER=postgres
DB_PASSWORD=postgres_dev_password_change_in_prod
DB_NAME=hyperlocal_marketplace
DB_PORT=5432
DB_HOST=localhost

# --- Application Connection URL (e.g. for Prisma, Drizzle, TypeORM, SQLAlchemy) ---
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres_dev_password_change_in_prod@localhost:5432/hyperlocal_marketplace?sslmode=disable

# --- AI Natural Language Parsing (LLM Providers) ---
# Select provider: 'auto' (detects available key), 'gemini', 'openai', 'anthropic', or 'mock' (offline fallback)
LLM_PROVIDER=auto

# Google Gemini (Recommended default: fast & cost effective)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
